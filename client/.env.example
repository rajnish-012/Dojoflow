# Required when building the frontend for production. This value is embedded
# into the browser bundle at build time and must point to the deployed API.
NEXT_PUBLIC_API_URL=https://api.example.com/api

# Optional public website metadata / configured captcha site key.
# NEXT_PUBLIC_WEBSITE_URL=https://www.example.com
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
