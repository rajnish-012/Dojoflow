# Required by the API in every environment.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/dojoflow
JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# Required in production. Comma-separated exact frontend origins are allowed.
# Development defaults to http://localhost:3000 when omitted.
CLIENT_URL=http://localhost:3000

# Optional when running behind a known reverse proxy. Set to the exact number
# of trusted proxy hops so rate limits use client IPs correctly.
# TRUST_PROXY_HOPS=1

# One-time account provisioning variables are supplied only when running
# `npm run provision:admin`; do not keep them in the long-lived deployment env.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Inquiry email SMTP credentials are managed in Settings > Email System and
# encrypted using a key derived from JWT_SECRET. Keep JWT_SECRET stable and
# back it up securely; rotating it requires re-encrypting stored SMTP secrets.
